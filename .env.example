# DeepSeek uses an OpenAI-compatible Chat Completions API.
# Copy this file to .env for local development, then add secrets only to .env.
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# Required only for POST /api/refresh. Use a long random value outside source control.
REFRESH_TOKEN=

# Optional comma-separated browser origins. Use * only for a public demo.
ALLOWED_ORIGINS=http://localhost:5173
